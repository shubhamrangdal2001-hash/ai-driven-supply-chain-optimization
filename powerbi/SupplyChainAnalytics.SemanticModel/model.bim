          },
          {
            "name": "Actual_Days",
            "dataType": "int64",
            "sourceColumn": "Actual_Days",
            "formatString": "0"
          },
          {
            "name": "Delay_Days",
            "dataType": "double",
            "sourceColumn": "Delay_Days",
            "formatString": "#,0.00"
          },
          {
            "name": "Is_Late",
            "dataType": "int64",
            "sourceColumn": "Is_Late",
            "formatString": "0"
          },
          {
            "name": "Late_Risk",
            "dataType": "int64",
            "sourceColumn": "Late_Risk",
            "formatString": "0"
          },
          {
            "name": "Quantity",
            "dataType": "int64",
            "sourceColumn": "Quantity",
            "formatString": "0"
          },
          {
            "name": "Revenue",
            "dataType": "double",
            "sourceColumn": "Revenue",
            "formatString": "#,0.00"
          },
          {
            "name": "Profit",
            "dataType": "double",
            "sourceColumn": "Profit",
            "formatString": "#,0.00"
          },
          {
            "name": "Discount_Rate",
            "dataType": "double",
            "sourceColumn": "Discount_Rate",
            "formatString": "#,0.00"
          },
          {
            "name": "Profit_Ratio",
            "dataType": "double",
            "sourceColumn": "Profit_Ratio",
            "formatString": "#,0.00"
          },
          {
            "name": "Profit_Margin",
            "dataType": "double",
            "sourceColumn": "Profit_Margin",
            "formatString": "#,0.00"
          },
          {
            "name": "Order_Status",
            "dataType": "string",
            "sourceColumn": "Order_Status"
          },
          {
            "name": "On_Time",
            "dataType": "int64",
            "sourceColumn": "On_Time",
            "formatString": "0"
          }
        ],
        "partitions": [
          {
            "name": "Fact_Orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"D:\\\\AI-Driven Supply Chain\\\\reports\\\\powerbi\\\\fact_orders.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\", {{\"Order_Date\", type date}, {\"Order_Year\", Int64.Type}, {\"Order_Month\", Int64.Type}, {\"Order_Quarter\", Int64.Type}, {\"Day_of_Week\", Int64.Type}, {\"Scheduled_Days\", Int64.Type}, {\"Actual_Days\", Int64.Type}, {\"Delay_Days\", type number}, {\"Is_Late\", Int64.Type}, {\"Late_Risk\", Int64.Type}, {\"Quantity\", Int64.Type}, {\"Revenue\", type number}, {\"Profit\", type number}, {\"Discount_Rate\", type number}, {\"Profit_Ratio\", type number}, {\"Profit_Margin\", type number}, {\"On_Time\", Int64.Type}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Revenue",
            "expression": "SUM(Fact_Orders[Revenue])",
            "formatString": "$#,0"
          },
          {
            "name": "Total Profit",
            "expression": "SUM(Fact_Orders[Profit])",
            "formatString": "$#,0"
          },
          {
            "name": "Total Orders",
            "expression": "COUNTROWS(Fact_Orders)",
            "formatString": "#,0"
          },
          {
            "name": "On-Time Delivery %",
            "expression": "DIVIDE(SUM(Fact_Orders[On_Time]), COUNTROWS(Fact_Orders))",
            "formatString": "0.0%"
          }
        ]
      },
