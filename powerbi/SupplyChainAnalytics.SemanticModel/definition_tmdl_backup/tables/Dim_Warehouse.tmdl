table Dim_Warehouse
	lineageTag: dim_warehouse-001

	partition Dim_Warehouse = m
		mode: import
		source =
				let
			    Source = Csv.Document(
			        File.Contents(PBI_DataPath & "\\dim_warehouse.csv"),
			        [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.None]
			    ),
			    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
		in
			#Promoted Headers
