table KPI_Summary
	lineageTag: kpi_summary-001

	partition KPI_Summary = m
		mode: import
		source =
				let
			    Source = Csv.Document(
			        File.Contents(PBI_DataPath & "\\kpi_summary.csv"),
			        [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.None]
			    ),
			    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
		in
			#Promoted Headers
